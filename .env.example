NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Server-only payment provider credentials.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
NEXT_PUBLIC_SITE_URL=https://your-marketplace-domain.com

# Admin allowlist: comma-separated account email addresses (server only).
MARKETPLACE_ADMIN_EMAILS=
# Platform commission on seller payouts, in basis points (e.g. 1000 = 10%).
# Set only after approving the marketplace fee policy. Allowed range: 0–3000.
MARKETPLACE_COMMISSION_BPS=
